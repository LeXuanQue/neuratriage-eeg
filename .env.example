# Copy to .env and edit — never commit the filled-in file.
# Startup: cd eeg-stroke-app && backend\run_app.bat   (Windows)
#          uvicorn app.main:app --host 127.0.0.1 --port 8501 --reload  (in backend/)
# Train:   .venv\Scripts\python backend\train_model.py --trials 40
# Migrate: cd backend && alembic upgrade head

# Set APP_ENV=production on a real host: enables HSTS + CSP response headers and
# makes the app REFUSE to boot unless JWT_SECRET is strong (not the dev default,
# >= 32 chars). Always deploy with a single worker (in-memory model/session state).
APP_ENV=development
APP_NAME=NeuraTriage EEG
APP_VERSION=0.2.0
PORT=8501

# Production: replace with a 64+ char random string.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-64-char-random-string
JWT_EXPIRES_HOURS=8

# Comma-separated CORS origins used by backend/app/config.py.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Model file path (relative to repo root). Train first with train_model.py.
# SHA256 of the loaded model is logged at startup for integrity checks.
MODEL_PATH=backend/models/model.joblib
AUTO_LOAD_MODEL_ON_STARTUP=true

# Rate limits (in-memory, resets on server restart)
# login: 5 attempts / 60s per IP   (hardcoded in services/rate_limit.py)
# infer: 20 requests / 60s per IP  (hardcoded in services/rate_limit.py)

# Weekly report email. Leave SENDGRID_API_KEY empty to generate PDFs only.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@neuratriage.ai
SENDGRID_FROM_NAME=NeuraTriage EEG
WEEKLY_REPORT_DOW=mon
WEEKLY_REPORT_HOUR=7
