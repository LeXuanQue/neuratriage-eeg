# Copy to .env (local) or set in Vercel project Settings → Environment Variables.
# NEVER commit .env. The .gitignore already excludes it.

# JWT signing key. PRODUCTION: 64+ random chars, rotate quarterly.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-64-char-random-string

# Token lifetime in hours (default 8). Clinical staff shift = 8h.
JWT_EXPIRES_HOURS=8

# Allowed CORS origin. PRODUCTION: exact Vercel domain.
# Dev: leave "*" (only allowed when running locally).
FRONTEND_ORIGIN=https://neuratriage-eeg.vercel.app

# Path to trained model joblib. Must exist on serverless filesystem.
# Vercel: bundle a small model under backend/models/model.joblib via includeFiles.
MODEL_PATH=backend/models/model.joblib
